# Same Supabase project as the website (eslam-platform). Only the public values belong here:
# the secret key stays on the website's server.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The website, used for the /api/v1 endpoints that need server secrets (exams, OTP, certificates).
EXPO_PUBLIC_SITE_URL=https://example.com

# Optional: crash reports (Sentry) and anonymous analytics (PostHog). Off when empty.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
