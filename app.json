{
  "expo": {
    "name": "المنارة",
    "slug": "mmubarakdev",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/icon.png",
    "scheme": "almanara",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#fbf8f1",
    "ios": {
      "bundleIdentifier": "com.almanara.app",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar",
        "ExpoLocalization_forcesRTL": true,
        "CFBundleLocalizations": [
          "ar"
        ],
        "NSSpeechRecognitionUsageDescription": "يستخدم المنارة التعرّف على الكلام في التسميع ليتابع تلاوتك وينبهك عند الخطأ.",
        "NSMicrophoneUsageDescription": "يستخدم المنارة الميكروفون في التسميع ليستمع إلى تلاوتك من حفظك."
      },
      "associatedDomains": [
        "applinks:eslami-platform.vercel.app"
      ],
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.almanara.app"
        ]
      }
    },
    "android": {
      "package": "com.almanara.app",
      "adaptiveIcon": {
        "backgroundColor": "#003e32",
        "foregroundImage": "./assets/images/brand/icon-maskable.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/quran"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/listen"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/radio"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/hadith"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/prayer-times"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/calendar"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/adhkar"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/tasbih"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/ruqyah"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/khatm-dua"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/nawawi"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/ibtihalat"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/tawasheeh"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/duas"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/adhan"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/stories"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/dashboard"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/plan"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/khatma"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/exams"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/certificates"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/tasmee"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/privacy"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/terms"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/kids"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/recordings"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withAlmanaraBackground",
      "./plugins/withAppShortcuts",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#003e32",
          "image": "./assets/images/brand/logo.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#012a22",
            "image": "./assets/images/brand/logo.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "ar"
          ],
          "forcesRTL": true
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#003e32",
          "sounds": [
            "./assets/audio/adhan_short.wav"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "يستخدم المنارة الميكروفون في التسميع ليستمع إلى تلاوتك من حفظك.",
          "speechRecognitionPermission": "يستخدم المنارة التعرّف على الكلام في التسميع ليتابع تلاوتك وينبهك عند الخطأ.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج المنارة إلى صورك لترفع صورة تحويل الدعم عبر إنستاباي.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/ibm-plex-sans-arabic/700Bold/IBMPlexSansArabic_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "NextPrayer",
              "label": "الصلاة القادمة",
              "description": "موعد الصلاة القادمة ومواقيت اليوم",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ContinueReading",
              "label": "تابع القراءة",
              "description": "افتح المصحف من حيث توقفت",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "Tasbih",
              "label": "ذكر",
              "description": "ذكر قصير يتجدد كل ساعة مع عدّاد للتسبيح",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              "./node_modules/@expo-google-fonts/ibm-plex-sans-arabic/400Regular/IBMPlexSansArabic_400Regular.ttf",
              "./node_modules/@expo-google-fonts/ibm-plex-sans-arabic/500Medium/IBMPlexSansArabic_500Medium.ttf",
              "./node_modules/@expo-google-fonts/ibm-plex-sans-arabic/600SemiBold/IBMPlexSansArabic_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/ibm-plex-sans-arabic/700Bold/IBMPlexSansArabic_700Bold.ttf",
              "./node_modules/@expo-google-fonts/amiri-quran/400Regular/AmiriQuran_400Regular.ttf",
              "./node_modules/@expo-google-fonts/baloo-bhaijaan-2/600SemiBold/BalooBhaijaan2_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/baloo-bhaijaan-2/800ExtraBold/BalooBhaijaan2_800ExtraBold.ttf",
              "./assets/fonts/UthmanicHafs.ttf"
            ]
          }
        }
      ],
      "expo-asset",
      "expo-web-browser",
      "@bacons/apple-targets",
      "@sentry/react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5b1c6666-c3ea-4479-8bb9-230b66e01410"
      }
    },
    "owner": "mmubarakdevs-team"
  }
}
