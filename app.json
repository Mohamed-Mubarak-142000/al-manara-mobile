{
  "expo": {
    "name": "المنارة",
    "slug": "almanara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/icon.png",
    "scheme": "almanara",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#fbf8f1",
    "ios": {
      "bundleIdentifier": "com.almanara.app",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar"
      }
    },
    "android": {
      "package": "com.almanara.app",
      "adaptiveIcon": {
        "backgroundColor": "#003e32",
        "foregroundImage": "./assets/images/brand/icon-maskable.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#003e32",
          "image": "./assets/images/brand/logo.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#012a22",
            "image": "./assets/images/brand/logo.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["ar"],
          "forcesRTL": true
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#003e32"
        }
      ],
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "يستخدم المنارة الميكروفون في التسميع ليستمع إلى تلاوتك من حفظك.",
          "speechRecognitionPermission": "يستخدم المنارة التعرّف على الكلام في التسميع ليتابع تلاوتك وينبهك عند الخطأ.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      "expo-iap",
      [
        "react-native-android-widget",
        {
          "fonts": ["./node_modules/@expo-google-fonts/cairo/700Bold/Cairo_700Bold.ttf"],
          "widgets": [
            {
              "name": "NextPrayer",
              "label": "الصلاة القادمة",
              "description": "موعد الصلاة القادمة ومواقيت اليوم",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ContinueReading",
              "label": "تابع القراءة",
              "description": "افتح المصحف من حيث توقفت",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
