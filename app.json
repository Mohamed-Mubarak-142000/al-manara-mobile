{
  "expo": {
    "name": "المنارة",
    "slug": "almanara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/icon.png",
    "scheme": "almanara",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#fbf8f1",
    "ios": {
      "bundleIdentifier": "com.almanara.app",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar",
        "ExpoLocalization_forcesRTL": true,
        "CFBundleLocalizations": ["ar"],
        "NSSpeechRecognitionUsageDescription": "يستخدم المنارة التعرّف على الكلام في التسميع ليتابع تلاوتك وينبهك عند الخطأ.",
        "NSMicrophoneUsageDescription": "يستخدم المنارة الميكروفون في التسميع ليستمع إلى تلاوتك من حفظك."
      },
      "associatedDomains": ["applinks:eslami-platform.vercel.app"],
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.almanara.app"]
      }
    },
    "android": {
      "package": "com.almanara.app",
      "adaptiveIcon": {
        "backgroundColor": "#003e32",
        "foregroundImage": "./assets/images/brand/icon-maskable.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/quran"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/listen"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/radio"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/hadith"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/prayer-times"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/calendar"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/adhkar"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/ibtihalat"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/tawasheeh"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/duas"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/adhan"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/stories"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/dashboard"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/plan"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/khatma"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/exams"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/certificates"
            },
            {
              "scheme": "https",
              "host": "eslami-platform.vercel.app",
              "pathPrefix": "/tasmee"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#003e32",
          "image": "./assets/images/brand/logo.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#012a22",
            "image": "./assets/images/brand/logo.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["ar"],
          "forcesRTL": true
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#003e32"
        }
      ],
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "يستخدم المنارة الميكروفون في التسميع ليستمع إلى تلاوتك من حفظك.",
          "speechRecognitionPermission": "يستخدم المنارة التعرّف على الكلام في التسميع ليتابع تلاوتك وينبهك عند الخطأ.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      "expo-iap",
      [
        "react-native-android-widget",
        {
          "fonts": ["./node_modules/@expo-google-fonts/cairo/700Bold/Cairo_700Bold.ttf"],
          "widgets": [
            {
              "name": "NextPrayer",
              "label": "الصلاة القادمة",
              "description": "موعد الصلاة القادمة ومواقيت اليوم",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ContinueReading",
              "label": "تابع القراءة",
              "description": "افتح المصحف من حيث توقفت",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ],
      "expo-asset",
      "expo-web-browser",
      "@bacons/apple-targets",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a8c16d2a-5e1e-422f-970b-96d9bdb2cc29"
      }
    },
    "owner": "mhamed_mubarak"
  }
}
